    "constraints": [
        {
            "id": "c1",
            "kind": "семантичне",
            "description": "За відсутності резервних бортів глибина резерву дорівнює нулю, а політика керування резервом не має предмета й набуває значення «відсутня». Канали відновлення O4 чинності не втрачають: борт, що зійшов з позиції, повертається після відновлення",
            "rule_type": "conditional",
            "conditions": [
                {
                    "feature": "O1",
                    "value": "без резерву"
                }
            ],
            "actions": [
                {
                    "feature": "O2",
                    "mode": "block",
                    "blocked_values": [
                        "1",
                        ">1"
                    ]
                },
                {
                    "feature": "O8",
                    "mode": "block",
                    "blocked_values": [
                        "статична",
                        "пріоритетна (hot-first)",
                        "адаптивна (mh↔mc)"
